# VMA local environment. Copy to .env and fill in. Never commit the real file.
# Used by docker-compose.yml.

# Login gate
VMA_AUTH_EMAIL=you@example.com
# Generate with: node scripts/hash-password.mjs 'your-password'
# The value uses ':' separators, not '$', so Docker Compose and the shell
# leave it alone instead of interpolating it as a variable.
VMA_AUTH_PASSWORD_HASH=pbkdf2:210000:replace-me:replace-me
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
VMA_SESSION_SECRET=replace-me-with-a-long-random-string

# Set true only if a provider lives on a private network (e.g. self-hosted Ollama)
VMA_ALLOW_PRIVATE_BASEURL=false

