# VMA local environment. Copy to .env and fill in. Never commit the real file.
# Used by docker-compose.yml.

# Login gate
VMA_AUTH_EMAIL=you@example.com
# Generate with: node scripts/hash-password.mjs 'your-password'
# The value uses ':' separators, not '$', so Docker Compose and the shell
# leave it alone instead of interpolating it as a variable.
VMA_AUTH_PASSWORD_HASH=pbkdf2:210000:replace-me:replace-me
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
VMA_SESSION_SECRET=replace-me-with-a-long-random-string

# Set true only if a provider lives on a private network (e.g. self-hosted Ollama)
VMA_ALLOW_PRIVATE_BASEURL=false

# --- Workspace config sync ---
# Providers, agents and sessions are stored server-side so they follow you to
# another device. API keys inside that store are encrypted with this key.
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# Falls back to VMA_SESSION_SECRET when unset. Changing it makes the existing
# store unreadable, so set it once and keep it.
VMA_CONFIG_KEY=

# Where the config store is written. In Docker this is a mounted volume.
VMA_DATA_DIR=./data

# --- Deep Search ---
# Wikipedia is always used and needs no key. It is good for background and
# definitions, and poor for business or technical questions: a search for
# "unit economics of SaaS startups" returns encyclopedia articles about
# companies, not benchmarks. Add one of these for questions like that.
#
# Tavily: a real web search API. Free tier is enough to evaluate.
# VMA_TAVILY_API_KEY=tvly-...
#
# SearXNG: your own instance, so no per-query cost and no captcha.
# VMA_SEARXNG_URL=https://searx.example.com
#
# Browser search: opens the result page in a real Chrome for queries the API layers
# cannot answer, such as "what regulation governs PPh 21" where the useful document is
# a PDF on a government site. It runs only when the fast layers come back with nothing
# relevant, and it needs Chrome installed, so it is off unless asked for.
#
# Google is not offered as an engine: the first request from a home connection was
# answered with a CAPTCHA. Ecosia and Brave answer without a challenge and are the
# defaults.
# VMA_BROWSER_SEARCH=1

# --- Cost guards on /api/chat ---
VMA_CHAT_MAX_REQUESTS=150
VMA_CHAT_WINDOW_SECONDS=300
VMA_MAX_BODY_BYTES=1000000


